/* 暮色酒馆 — Dark Theme */

Screen {
    background: #1e1e20;
}

#main-grid {
    layout: horizontal;
    height: 1fr;
    background: #1e1e20;
}

/* === CharacterList (Left Panel) === */

CharacterList {
    width: 24;
    height: 1fr;
    background: #19191a;
    border-right: tall #434347;
    padding: 0;
    color: #dddddd;
    layout: vertical;
}

CharacterList #char-options {
    height: 1fr;
    scrollbar-size: 1 1;
    scrollbar-background: #1e1e20;
    scrollbar-color: #444444;
}

CharacterList .option-list--option {
    color: #dddddd;
}

CharacterList .option-list--option-highlighted {
    background: #333333;
    color: #ffffff;
}

CharacterList #event-log {
    height: 8;
    border-top: tall #434347;
    background: #141416;
    color: #999999;
    padding: 0 1;
    scrollbar-size: 1 1;
    scrollbar-background: #141416;
    scrollbar-color: #333333;
}

/* === ScenePanel (Center Panel) === */

ScenePanel {
    width: 1fr;
    height: 1fr;
    background: #1e1e20;
    layout: vertical;
}

ScenePanel #scene-desc {
    height: auto;
    max-height: 3;
    background: #19191a;
    color: #999999;
    padding: 1 2;
    border-bottom: tall #434347;
}

ScenePanel #dialogue-log {
    height: 1fr;
    background: #1e1e20;
    color: #dddddd;
    padding: 1 2;
    scrollbar-size: 1 1;
    scrollbar-background: #1e1e20;
    scrollbar-color: #444444;
}

ScenePanel #input-bar {
    height: 3;
    background: #2a2a2a;
    border-top: tall #434347;
    padding: 0 1;
}

ScenePanel #msg-input {
    width: 1fr;
    color: #111111;
    background: #cccccc;
    border: tall #888888;
}

ScenePanel #msg-input:focus {
    border: tall #666666;
}

ScenePanel Input {
    color: #111111;
    background: #cccccc;
}

ScenePanel .input--placeholder {
    color: #666666;
}

ScenePanel .input--cursor {
    color: #ffffff;
    background: #666666;
}

/* === CharacterDetail (Right Panel) === */

CharacterDetail {
    width: 24;
    height: 1fr;
    background: #19191a;
    border-left: tall #434347;
    padding: 1;
    color: #dddddd;
    scrollbar-size: 1 1;
    scrollbar-background: #1e1e20;
    scrollbar-color: #444444;
}

CharacterDetail .detail-label {
    color: #777777;
}

CharacterDetail .detail-value {
    color: #dddddd;
}
